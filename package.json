{
  "name": "omnidays",
  "version": "0.1.0",
  "description": "Shows the number of days until or since a date.",
  "keywords": [
    "countdown",
    "countup",
    "date",
    "days",
    "since",
    "until"
  ],
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "vp build --watch --mode development",
    "build": "vp build --mode production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "prepare": "vp config",
    "lint": "eslint src"
  },
  "dependencies": {
    "obsidian": "latest"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "@typescript-eslint/parser": "^8.59.3",
    "builtin-modules": "^5.2.0",
    "eslint": "^10.3.0",
    "eslint-plugin-obsidianmd": "^0.3.0",
    "globals": "17.6.0",
    "jiti": "2.7.0",
    "tslib": "2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.59.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@^0.1.21",
    "vite-plus": "latest"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@latest",
      "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
    },
    "peerDependencyRules": {
      "allowAny": [
        "vite",
        "vitest"
      ],
      "allowedVersions": {
        "vite": "*",
        "vitest": "*"
      }
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
